@@ -0,0 +1,112 @@
+name: Publish uNews version release
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'archive/development/*/release.json'
+      - '.github/workflows/publish-version-release.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  publish:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    env:
+      GH_TOKEN: ${{ github.token }}
+
+    steps:
+      - name: Checkout exact main commit
+        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
+        with:
+          fetch-depth: 0
+
+      - name: Publish missing uNews release checkpoints
+        shell: bash
+        run: |
+          set -euo pipefail
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+
+          mapfile -t manifests < <(find archive/development -mindepth 2 -maxdepth 2 -name release.json -type f | sort)
+          if [ "${#manifests[@]}" -eq 0 ]; then
+            echo "No uNews release manifests found."
+            exit 0
+          fi
+
+          for manifest in "${manifests[@]}"; do
+            eval "$(node --input-type=module - "$manifest" <<'NODE'
+          import fs from 'node:fs';
+          const data = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
+          const quote = (value) => `'${String(value).replaceAll("'", "'\\''")}'`;
+          console.log(`VERSION=${quote(data.version)}`);
+          console.log(`TAG=${quote(data.tag)}`);
+          console.log(`TITLE=${quote(data.title)}`);
+          console.log(`PRERELEASE=${quote(Boolean(data.prerelease) ? 'true' : 'false')}`);
+          console.log(`SOURCE_COMMIT=${quote(data.sourceCommit)}`);
+          console.log(`PATCHNOTE=${quote(data.patchnote)}`);
+          console.log(`IMAGE=${quote(data.image)}`);
+          console.log(`ARCHIVE=${quote(data.archive)}`);
+          NODE
+          )"
+
+            if ! git merge-base --is-ancestor "$SOURCE_COMMIT" "$GITHUB_SHA"; then
+              echo "Skip ${VERSION}: source commit is not part of current main."
+              continue
+            fi
+            for required in "$PATCHNOTE" "$IMAGE" "$ARCHIVE"; do
+              test -f "$required" || { echo "Missing release file: $required"; exit 1; }
+            done
+
+            release_exists=false
+            if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
+              release_exists=true
+            fi
+            remote_tag_sha="$(git ls-remote origin "refs/tags/${TAG}" | head -n1 | cut -f1)"
+            remote_tag_commit="$(git ls-remote origin "refs/tags/${TAG}^{}" | head -n1 | cut -f1)"
+            [ -n "$remote_tag_commit" ] || remote_tag_commit="$remote_tag_sha"
+
+            rollback_branch="release/v${VERSION}"
+            remote_branch_sha="$(git ls-remote origin "refs/heads/${rollback_branch}" | cut -f1)"
+            if [ -z "$remote_branch_sha" ]; then
+              git push origin "$GITHUB_SHA:refs/heads/${rollback_branch}"
+            elif [ "$remote_branch_sha" = "$GITHUB_SHA" ]; then
+              echo "Rollback branch already matches main."
+            elif [ -n "$remote_tag_sha" ] || [ "$release_exists" = "true" ]; then
+              echo "Published checkpoint differs; refusing to move rollback branch."
+              exit 1
+            elif git merge-base --is-ancestor "$remote_branch_sha" "$GITHUB_SHA"; then
+              git push origin "$GITHUB_SHA:refs/heads/${rollback_branch}"
+            else
+              echo "Rollback branch is not a fast-forward ancestor."
+              exit 1
+            fi
+
+            if [ -z "$remote_tag_sha" ]; then
+              git tag -a "$TAG" "$GITHUB_SHA" -m "$TITLE"
+              git push origin "refs/tags/${TAG}"
+            elif [ "$remote_tag_commit" != "$GITHUB_SHA" ]; then
+              echo "Existing tag points to ${remote_tag_commit}; refusing to move it."
+              exit 1
+            fi
+
+            if [ "$release_exists" = "true" ]; then
+              echo "GitHub Release ${TAG} already exists."
+              continue
+            fi
+
+            args=(
+              "$TAG"
+              "$ARCHIVE#Development evidence archive"
+              "$IMAGE#Focused release screenshot"
+              --repo "$GITHUB_REPOSITORY"
+              --verify-tag
+              --title "$TITLE"
+              --notes-file "$PATCHNOTE"
+            )
+            if [ "$PRERELEASE" = "true" ]; then args+=(--prerelease); fi
+            gh release create "${args[@]}"
+          done
